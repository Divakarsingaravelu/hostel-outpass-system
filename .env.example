# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key

# Database (leave empty for SQLite dev default)
DATABASE_URL=

# Email (console fallback in dev)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=hostel-outpass@college.edu

# App settings
MAX_UPLOAD_SIZE_MB=2
UPLOAD_FOLDER=app/static/uploads
QR_SIGNING_SECRET=change-this-qr-secret
PASSWORD_RESET_EXPIRY=3600
SESSION_TIMEOUT_MINUTES=30
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15
